{
	"name": "pss-shopift-order-details-fetcher",
	"build":{
		"dockerfile": "Dockerfile"
	},
	"runArgs": ["--network=host"],
	"postCreateCommand": "npm install",
	"remoteEnv": {
		"CHOKIDAR_USEPOLLING": "true",
		"CHOKIDAR_INTERVAL": "500"
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"esbenp.prettier-vscode",
				"yoavbls.pretty-ts-errors"
			]
		}
	}
}
